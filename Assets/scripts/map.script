local enemy = {}
local boxes = {}

local enemyTable = {vmath.vector3(0, 320, 0), vmath.vector3(560, 240, 0), vmath.vector3(940, -220, 0), vmath.vector3(2060, 140, 0)}
local boxTable = {{vmath.vector3(380, 150, 0), 1, 3}, {vmath.vector3(420, 170, 0), 1, 1}, {vmath.vector3(420, 240, 0), 1, 1}, {vmath.vector3(610, -120, 0), 2, 10}, {vmath.vector3(1130, 130, 0), 2, 3}}

local player = require("Assets.scripts.player")

local function reset()
	
	go.set_position(vmath.vector3(-300.0, 150, 0), "/player")
	go.set_position(vmath.vector3(-300.0, 150, 0), "/camera")

	player.reset()

	for i, v in ipairs(enemy or {}) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	for i, v in ipairs(boxes or {}) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	enemy = {}
	for i, v in ipairs(enemyTable) do
		pprint("done!")
		table.insert(enemy, factory.create("#enemyfact", v, nil, nil, 1))
	end
	for i, v in ipairs(boxTable) do
		pprint("done!")
		table.insert(enemy, factory.create("#boxfact", v[1], nil, {hitPoints = v[3] or 10}, v[2] or 1))
	end
	
end

function init(self)
	reset()
end

function on_message(self, message_id, message, sender)
	if message_id == hash("reset") then
		reset()
	end
end