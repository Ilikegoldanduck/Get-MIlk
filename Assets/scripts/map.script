local map = {}

local inReset = false

local enemyTable = {
	vmath.vector3(0, 320, 0), 
	vmath.vector3(560, 240, 0), 
	vmath.vector3(580, 240, 0), 
	vmath.vector3(940, -220, 0), 
	vmath.vector3(2060, 140, 0), 
	vmath.vector3(2650, 180, 0), 
	vmath.vector3(2140, 300, 0), 
	vmath.vector3(2800, 200, 0),
	vmath.vector3(100, 360, 0),
	vmath.vector3(400, -350, 0),
	vmath.vector3(700, -350, 0),
	vmath.vector3(500, -120, 0),
	vmath.vector3(350, 140, 0),
	vmath.vector3(-250, 400, 0)
}

local boxTable = {
	{vmath.vector3(380, 150, 0), 1, 3}, 
	{vmath.vector3(420, 170, 0), 1, 2}, 
	{vmath.vector3(420, 240, 0), 1, 2}, 
	{vmath.vector3(610, -120, 0), 2, 10}, 
	{vmath.vector3(1130, 130, 0), 2, 2}, 
	{vmath.vector3(1320, 130, 0), 2, 2}, 
	{vmath.vector3(2100, 300, 0), 2, 2}, 
	{vmath.vector3(2100, 200, 0), 2, 2}, 
	{vmath.vector3(2100, 100, 0), 2, 2},
	{vmath.vector3(-130, 140, 0), 2, 5},
	{vmath.vector3(-200, 300, 0), 2, 5},
	{vmath.vector3(-250, 300, 0), 2, 5},
	{vmath.vector3(500, 150, 0), 3, 5},
	{vmath.vector3(-1800, 300, 0), 1, 5}
}

local player = require("Assets.scripts.player")

local function reset()
	
	go.set_position(vmath.vector3(-300.0, 150, 0), "/player")
	go.set_position(vmath.vector3(-300.0, 150, 0), "/camera")

	player.reset()

	for i, v in ipairs(map or {}) do
		if go.exists(v) then
			go.delete(v)
		end
	end

	map = {}
	
	for i, v in ipairs(boxTable) do
		table.insert(map, factory.create("#boxfact", v[1], nil, {hitPoints = v[3] or 10}, v[2] or 1))
	end
	for i, v in ipairs(enemyTable) do
		table.insert(map, factory.create("#enemyfact", v, nil, nil, 1))
	end
end

function init(self)
	timer.delay(.5, false, function()
		reset()
	end)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("reset") and not inReset then
		inReset = true
		reset()
		inReset = false
	end
end