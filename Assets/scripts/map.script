local enemy = {}
local boxes = {}

local enemyTable = {vmath.vector3(100, 100, 0)}
local boxTable = {vmath.vector3(100, 100, 0)}

local function reset()
	
	go.set_position(vmath.vector3(0, 100, 0), "/player")
	go.set_position(vmath.vector3(0, 100, 0), "/camera")

	for i, v in ipairs(enemy or {}) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	for i, v in ipairs(boxes or {}) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	enemy = {}
	for i, v in ipairs(enemyTable) do
		pprint("done!")
		table.insert(enemy, factory.create("#enemyfact", v, nil, nil, 1))
	end
	for i, v in ipairs(boxTable) do
		pprint("done!")
		table.insert(enemy, factory.create("#boxfact", v, nil, nil, 1))
	end
	
end

function init(self)
	reset()
end

