go.property("hitPoints", 10)
go.property("refractory", false)

function on_message(self, message_id, message, sender)
	if message.other_group == hash("playerBullet") or message.other_group == hash("enemyBullet") then
		if not self.refractory then
			self.hitPoints = self.hitPoints - 1
			self.refractory = true
			timer.delay(.1, false, function()
				self.refractory = false
			end)
		end
		if self.hitPoints == 0 then
			go.delete()
		elseif self.hitPoints == 1 then
			sprite.play_flipbook("#sprite", "frame0011")
		end
	elseif message.other_group == hash("spikes") then
		go.delete()
	end
end