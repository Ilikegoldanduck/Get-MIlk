	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message.other_group == hash("ground") then
		onGround = true
	end
end

function on_input(self, action_id, action)
	local windowX, windowY = window.get_size()

	if action.x then
		mouseposX = (action.x - windowX / 2)
	else

	end
	if action.y then
		mouseposY = (action.y - windowY / 2)
	else

	end

	local currVel = go.get("#collisionobject", "linear_velocity")
	if action_id == hash("touch") and action.pressed then
	elseif action_id == hash("Left") then
		currVel = currVel + vmath.vector3(-10, 0, 0)
		go.set("#collisionobject", "linear_velocity", currVel)
	elseif action_id == hash("Right") then
		currVel = currVel + vmath.vector3(10, 0, 0)
		go.set("#collisionobject", "linear_velocity", currVel)
	elseif action_id == hash("Jump") and onGround then
		currVel = currVel + vmath.vector3(0, 200, 0)
		go.set("#collisionobject", "linear_velocity", currVel)
	end
end

