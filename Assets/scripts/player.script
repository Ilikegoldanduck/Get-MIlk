local onGround = true
local mouseposX, mousepoxY = 0, 0

local prevAngle = 0
local angle = 0

local gunCd = 5
local gunTracker = true --true = shootable; false = not shootable

local health = 3

function init(self)
	msg.post(".", "acquire_input_focus")
	timer.delay(.1, true, function()

		angle = math.deg(math.atan2(mouseposY, mouseposX))
		
		if prevAngle - angle > 180 then
			pprint(prevAngle)
			if prevAngle < 0 then
				go.set("/gun", "euler.z", prevAngle + 360)
			else
				go.set("/gun", "euler.z", prevAngle - 360)
			end
			go.animate("/gun", "euler.z", go.PLAYBACK_ONCE_FORWARD, angle, go.EASING_LINEAR, .1, 0)
		else
			go.animate("/gun", "euler.z", go.PLAYBACK_ONCE_FORWARD, angle, go.EASING_LINEAR, .1, 0)
		end
		prevAngle = angle

		go.animate("/camera", "position", go.PLAYBACK_ONCE_FORWARD, go.get_position(), go.EASING_LINEAR, .2, 0)
	end)
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	onGround = false
end

