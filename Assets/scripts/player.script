local onGround = true
local mouseposX = 0
local mousepoxY = 0

local prevAngle = 0
local angle = 0

local player = require("Assets.scripts.player")
local hitframe = false

local npc = nil

function init(self)
	msg.post(".", "acquire_input_focus")
	msg.post("/camera#main", "talk", {hash("/start")})
	timer.delay(.1, true, function()
		
		angle = math.deg(math.atan2(mouseposY, mouseposX))
		
		if prevAngle - angle > 180 then
			if prevAngle < 0 then
				go.set("/gun", "euler.z", prevAngle + 360)
			else
				go.set("/gun", "euler.z", prevAngle - 360)
			end
			go.animate("/gun", "euler.z", go.PLAYBACK_ONCE_FORWARD, angle, go.EASING_LINEAR, .1, 0)
		else
			go.animate("/gun", "euler.z", go.PLAYBACK_ONCE_FORWARD, angle, go.EASING_LINEAR, .1, 0)
		end
		prevAngle = angle

		go.animate("/camera", "position", go.PLAYBACK_ONCE_FORWARD, go.get_position(), go.EASING_LINEAR, .2, 0)
	end)
end

function update(self, dt)
	onGround = false
	npc = nil
end

function on_message(self, message_id, message, sender)
	if not player.getToggle() then
		local vel = go.get("#collisionobject", "linear_velocity")
		if (message.other_group == hash("ground") and math.abs(vel.y) <= 2) or (message.other_group == hash("boxes") and math.abs(vel.y) <= 2) then
			onGround = true
		elseif (message.other_group == hash("enemyBullet")) and not hitframe then
			player.setHealth(player.getHealth() - 1)
			hitframe = true
			timer.delay(.1, false, function()
				hitframe = false
			end)
		elseif message_id == hash("tix") then
			player.addTix(1)
		elseif message.other_group == hash("spikes") and not hitframe then
			hitframe = true
			go.set("#collisionobject", "linear_velocity", -vel + vmath.vector3(0, 350, 0))
			player.setHealth(player.getHealth() - 1)
			timer.delay(.1, false, function()
				hitframe = false
			end)
		elseif message.other_group == hash("npc") then
			npc = message.other_id
			msg.post("/camera#main", "npc", {})
		end
		if player.getHealth() == 0 then
			msg.post("/map#map", "reset", {})
			player.setHealth(3)
		end
	end
end

function on_input(self, action_id, action)


	local windowX, windowY = window.get_size()

	if action.x then
		mouseposX = (action.x - windowX / 2)
	else

	end
	if action.y then
		mouseposY = (action.y - windowY / 2)
	else

	end
	
	if not player.getToggle() then

		local currVel = go.get("#collisionobject", "linear_velocity")
		if action_id == hash("touch") and action.pressed then
			if player.gunCheck() then
				local tempRad = math.rad(angle)
				local bullet = factory.create("/player#bulletfact", go.get_position(), nil, {vector = vmath.vector3(math.cos(tempRad) * 500, math.sin(tempRad) * 500, 0)}, 1)
			end
		elseif action_id == hash("Left") then
			currVel = currVel + vmath.vector3(-5, 0, 0)
			go.set("#collisionobject", "linear_velocity", currVel)
		elseif action_id == hash("Right") then
			currVel = currVel + vmath.vector3(5, 0, 0)
			go.set("#collisionobject", "linear_velocity", currVel)
		elseif action_id == hash("Jump") and onGround then
			currVel = currVel + vmath.vector3(0, 350, 0)
			go.set("#collisionobject", "linear_velocity", currVel)
		elseif action_id == hash("Talk") and npc then
			go.delete(npc)
			msg.post("/camera#main", "talk", {npc})
		end

	end
end