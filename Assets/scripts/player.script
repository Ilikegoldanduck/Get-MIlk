function on_message(self, message_id, message, sender)
	if message.other_group == hash("ground") then
		onGround = true
	elseif message.other_group == hash("enemy") then
		health = health - 1
	elseif message.other_group == hash("enemyBullet") then
		health = health - 1
	end
	if health == 0 then
		msg.post()
		health = 3
	end
end

function on_input(self, action_id, action)
	local windowX, windowY = window.get_size()

	if action.x then
		mouseposX = (action.x - windowX / 2)
	else

	end
	if action.y then
		mouseposY = (action.y - windowY / 2)
	else

	end

	local currVel = go.get("#collisionobject", "linear_velocity")
	if action_id == hash("touch") and action.pressed then
		pprint("shot!")
		local tempRad = math.rad(angle)
		local bullet = factory.create("/player#bulletfact", go.get_position(), nil, {vector = vmath.vector3(math.cos(tempRad) * 1000, math.sin(tempRad) * 1000, 0)}, 1)
	elseif action_id == hash("Left") then
		currVel = currVel + vmath.vector3(-10, 0, 0)
		go.set("#collisionobject", "linear_velocity", currVel)
	elseif action_id == hash("Right") then
		currVel = currVel + vmath.vector3(10, 0, 0)
		go.set("#collisionobject", "linear_velocity", currVel)
	elseif action_id == hash("Jump") and onGround then
		currVel = currVel + vmath.vector3(0, 200, 0)
		go.set("#collisionobject", "linear_velocity", currVel)
	end
end

