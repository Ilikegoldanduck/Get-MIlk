function init(self)
	timer.delay(2.5, true, function()
		local playerPos = go.get_position("/player")
		local pos = go.get_position()

		local diffX = pos.x - playerPos.x
		local diffY = pos.y - playerPos.y 

		local dist = math.sqrt(math.pow(diffY, 2) + math.pow(diffX, 2))

		if dist < 250 then
			local vel = 100
			local grav = -1000

			local angley = math.pow(vel, 2) - math.sqrt(math.pow(vel, 4) - (grav * (grav * math.pow(diffX, 2) + 2 * diffY * math.pow(vel, 2))))
			local anglex = grav * diffX

			local angle = math.atan2(angley, anglex)

			local bullet = factory.create("#bulletfact", go.get_position(), nil, {vector = vmath.vector3(math.cos(angle or 0) * 500, math.sin(angle or 0) * 500, 0)}, 1)
		end
	end)
end

function on_message(self, message_id, message, sender)
	if message.other_group == hash("playerBullet") or message.other_group == hash("spikes") then
		go.delete()
	elseif message.other_group == hash("ground") then
		local vel = go.get("#collisionobject", "linear_velocity")
		if math.sqrt(math.pow(vel.y, 2) + math.pow(vel.x, 2)) > 350 then
			go.delete()
		end
	end
end