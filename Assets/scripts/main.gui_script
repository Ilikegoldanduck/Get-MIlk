local player = require("Assets.scripts.player")

local inTalk = false

local textTable = {
	{"'A' to move left, 'D' to move right, 'SPACE' to jump, 'T' to talk, 'M1' to Shoot", "Boxes are breakable", "I need milk...", "So... Thirsty...", "I need to go outside and get the milk."},
	{"Woah! This sign has \"Milk\" on it!", "I think I should follow the milk sign!", "Might be where the milk is..."},
	{"Hi! I'm bob!", "Milk? I... don't sell that here...", "I sell M.I.L.K! \nIt's uh... Musically Induced Left-handed Kritters!", "Oh ok! Have a good day!", "I heard there was milk to the right by the way. \nIt's pretty close, you won't miss it!"},
	{"heh. You fool. \nI AM NOT MILK", "I KNOW!! \nMWAHAAHAHAHA", "anyways, milk is to the right. \nI think they're almost out of stock"},
	{"Hi! You're our 10,000th customer!", "Milk? Yeah we sell that!!", "Uhh, just go over there and stuff!", "When does my shift end..."},
	{"Wow. You got the milk.", "Do you feel proud of yourself?", "Congrats.", "uhh *milk noises*", "yeah that's about it...", "why are you still here.", "umm, ladidadida sing song milk song lalala", "yeah just close the game bro", "byebye!!! I'm not doing this forever yk."},
	{"Erm.. why down there?", "I guess I should follow it...", "I mean.. signs are always right, right?"},
	{"I think it's close.", "I can feel the milk inside my soul", "that... sounded so bad T^T"},
	{"smh.. Can't believe there's a whole hole here.", "I still need to go on tho... I need the milk."}
}

local chosenText = {}
local textOn = 1

local function setHealth()
	local health = player.getHealth()
	if health == 3 then
		gui.set_enabled(gui.get_node("health1"), true)
		gui.set_enabled(gui.get_node("health2"), true)
		gui.set_enabled(gui.get_node("health3"), true)
	elseif health == 2 then
		gui.set_enabled(gui.get_node("health1"), true)
		gui.set_enabled(gui.get_node("health2"), true)
		gui.set_enabled(gui.get_node("health3"), false)
	elseif health == 1 then
		gui.set_enabled(gui.get_node("health1"), true)
		gui.set_enabled(gui.get_node("health2"), false)
		gui.set_enabled(gui.get_node("health3"), false)
	elseif health == 0 then
		gui.set_enabled(gui.get_node("health1"), false)
		gui.set_enabled(gui.get_node("health2"), false)
		gui.set_enabled(gui.get_node("health3"), false)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
end

function update(self, dt)
	gui.set_text(gui.get_node("info"), "Shootable: " .. tostring(player.gunCheckGui()))
	gui.set_enabled(gui.get_node("text1"), false)
	setHealth()
end

function on_message(self, message_id, message, sender)
	if message_id == hash("talk") then
		inTalk = true
		gui.animate(gui.get_node("textBox"), "position.y", 140, gui.EASING_LINEAR, 1, 0)
		if message[1] == hash("/start") then
			chosenText = textTable[1]
		elseif message[1] == hash("/sign1") then
			chosenText = textTable[2]
		elseif message[1] == hash("/bob") then
			chosenText = textTable[3]
		elseif message[1] == hash("/notmilk") then
			chosenText = textTable[4]
		elseif message[1] == hash("/shopkeeper") then
			chosenText = textTable[5]
		elseif message[1] == hash("/milk") then
			chosenText = textTable[6]
		elseif message[1] == hash("/sign2") then
			chosenText = textTable[7]
		elseif message[1] == hash("/sign3") then
			chosenText = textTable[8]
		elseif message[1] == hash("/optional1") then
			chosenText = textTable[9]
		end
		gui.set_text(gui.get_node("text"), chosenText[textOn])
		textOn = 2
		player.toggleMovement(true)
	elseif message_id == hash("npc") and not inTalk then
		gui.set_enabled(gui.get_node("text1"), true)
	end
end

function on_input(self, action_id, action)
	if inTalk and action_id == hash("Talk") and action.pressed then
		if chosenText[textOn] then
			gui.set_text(gui.get_node("text"), chosenText[textOn])
			textOn = textOn + 1
		else
			inTalk = false
			textOn = 1
			player.toggleMovement(false)
			gui.animate(gui.get_node("textBox"), "position.y", -180, gui.EASING_LINEAR, 1, 0)
		end
	end
end