local player = require("Assets.scripts.player")

local inTalk = false

local textTable = {
	{"I need milk...", "So... Thirsty..."},
	{"I think I should follow the milk sign"},
	{"Hi! I'm bob!", "Milk? I... don't sell that here...", "I sell M.I.L.K! It's uh... Musically Induced Left-handed Kritters!", "Oh ok! Have a good day!", "I heard there was milk to the right by the way. It's pretty close, you won't miss it!"},
	{"I... don't think that's milk..."},
	{"Hi! You're our 100th customer!", "Milk? Yeah we sell that!!", "When does my shift end."},
	{"Wow. You got the milk.", "Do you feel proud of yourself?", "Congrats.", "uhh *milk noises*"}
}

local chosenText = {}
local textOn = 1

function init(self)
	msg.post(".", "acquire_input_focus")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	gui.set_text(gui.get_node("info"), "Shootable: " .. tostring(player.gunCheckGui()) .. "\nHealth: " .. tostring(player.getHealth()) .. "\nTix: " .. tostring(player.getTix()))
	gui.set_enabled(gui.get_node("text1"), false)
end

function on_message(self, message_id, message, sender)
	pprint(message_id)
	pprint(message)
	if message_id == hash("talk") then
		inTalk = true
		gui.animate(gui.get_node("textBox"), "position.y", 140, gui.EASING_LINEAR, 1, 0)
		if message[1] == hash("/start") then
			chosenText = textTable[1]
		elseif message[1] == hash("/sign") then
			chosenText = textTable[2]
		elseif message[1] == hash("/bob") then
			chosenText = textTable[3]
		elseif message[1] == hash("/notmilk") then
			chosenText = textTable[4]
		elseif message[1] == hash("/shopkeeper") then
			chosenText = textTable[5]
		elseif message[1] == hash("/milk") then
			chosenText = textTable[6]
		end
		gui.set_text(gui.get_node("text"), chosenText[textOn])
		textOn = 2
		player.toggleMovement(true)
	elseif message_id == hash("npc") and not inTalk then
		gui.set_enabled(gui.get_node("text1"), true)
	end
end

function on_input(self, action_id, action)
	if inTalk and action_id == hash("Talk") and action.pressed then
		if chosenText[textOn] then
			gui.set_text(gui.get_node("text"), chosenText[textOn])
			textOn = textOn + 1
		else
			inTalk = false
			textOn = 1
			player.toggleMovement(false)
			gui.animate(gui.get_node("textBox"), "position.y", -180, gui.EASING_LINEAR, 1, 0)
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
